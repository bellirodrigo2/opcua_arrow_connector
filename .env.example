# PostgreSQL Database Configuration
DB_JDBC_URL=jdbc:postgresql://localhost:5432/opcua_arrow
DB_USERNAME=postgres
DB_PASSWORD=password

# Connection Pool Settings
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_CONNECTION_TIMEOUT_SECONDS=30
DB_QUERY_TIMEOUT_SECONDS=30
DB_AUTO_COMMIT=true
DB_TRANSACTION_ISOLATION=READ_COMMITTED

# Hot-Reload Configuration
HOT_RELOAD_INTERVAL_SECONDS=30
ENABLE_HOT_RELOAD=true

# Application Settings
SOURCE_NAME=production_line_1

# Retry Policy Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=500
RETRY_MAX_DELAY_MS=5000
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_USE_JITTER=true

# Logging Level (optional)
LOG_LEVEL=INFO