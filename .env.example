# Application Settings
APP_SOURCE_NAME=production_line_1
APP_UPDATE_INTERVAL_SECONDS=30
QUEUE_INITIAL_CAPACITY=1000
QUEUE_TIMEOUT_MS=5000
BUFFER_INITIAL_CAPACITY=2048
BUFFER_COMPRESSION_ENABLED=false
BUFFER_MIN_FLUSH_SIZE=1024
BUFFER_MIN_FLUSH_INTERVAL_MS=1000

# OPC UA Client Configuration
OPCUA_SERVER_URL=opc.tcp://localhost:4840
OPCUA_USERNAME=admin
OPCUA_PASSWORD=admin
REQUEST_TIMEOUT_MS=60000
SESSION_TIMEOUT_MS=120000
KEEP_ALIVE_INTERVAL_MS=30000

# PostgreSQL Database Configuration
DB_JDBC_URL=jdbc:postgresql://localhost:5432/opcua_arrow
DB_USERNAME=postgres
DB_PASSWORD=password
# Connection Pool Settings
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_CONNECTION_TIMEOUT_SECONDS=30
DB_QUERY_TIMEOUT_SECONDS=30
DB_AUTO_COMMIT=true
DB_TRANSACTION_ISOLATION=READ_COMMITTED

# Retry Policy Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=500
RETRY_MAX_DELAY_MS=5000
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_USE_JITTER=true

# Logging Level (optional)
LOG_LEVEL=INFO
